# # Backend environment (local defaults)
# APP_NAME="USV University Events Management Platform"
# ENV="local"

# # Default uses repo-local SQLite db. If you hit OneDrive/locking issues, point to a local path, e.g.:
# # DATABASE_URL="sqlite:///C:/Users/<you>/AppData/Local/usv-events-platform/app.db"
# # Supabase Postgres:
# # - Prefer *Direct connection* from Supabase Dashboard (Settings → Database).
# # - URL-encode DB password if it contains special chars like `@` / `:` / `/` (e.g. `@` -> `%40`).
# # Example:
# # DATABASE_URL="postgresql+psycopg://postgres.<project_ref>:<urlencoded_db_password>@db.<project_ref>.supabase.co:5432/postgres?sslmode=require"
# # If you use the pooler host `aws-*.pooler.supabase.com` and port 5432 is blocked by your network,
# # switch to Direct connection or the pooler port suggested by Supabase (often 6543).
# DATABASE_URL="sqlite:///./data/app.db"
# JWT_SECRET_KEY="CHANGE_ME_LOCAL_DEV_ONLY"
# JWT_ALGORITHM="HS256"
# JWT_ACCESS_TOKEN_EXPIRES_MINUTES="60"
# JWT_REFRESH_TOKEN_EXPIRES_DAYS="14"

# STORAGE_DIR="./storage"
# ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# # Integrations
# INTEGRATIONS_MODE="mock" # set to "real" to enable Google OAuth/Calendar
# FRONTEND_BASE_URL="http://localhost:5173"
# OAUTH_STATE_SECRET_KEY="CHANGE_ME_LOCAL_DEV_ONLY"
# # Comma-separated allowlist (preferred).
# STUDENT_EMAIL_DOMAINS="student.usv.ro"
# # (deprecated) single-domain value; if set, it is merged into STUDENT_EMAIL_DOMAINS.
# STUDENT_EMAIL_DOMAIN=""
# DEFAULT_TIMEZONE="Europe/Bucharest"
# GOOGLE_REDIRECT_URI="http://localhost:8000/auth/google/callback"
# GOOGLE_CALENDAR_ID="primary"

# # Google OAuth (required when INTEGRATIONS_MODE=real)
# # INTEGRATIONS_MODE=real
# # GOOGLE_CLIENT_ID=...
# # GOOGLE_CLIENT_SECRET=...
# # GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
# # FRONTEND_BASE_URL=http://127.0.0.1:5173
# # OAUTH_STATE_SECRET_KEY=some-long-random-string
# # STUDENT_EMAIL_DOMAINS=student.usv.ro
# # DEFAULT_TIMEZONE=Europe/Bucharest
# # GOOGLE_CALENDAR_ID=primary

# # Supabase / hosted Postgres (optional)
# # - Keep SERVICE_ROLE_KEY server-side only (never in frontend env).
# # - If you switch DATABASE_URL to Postgres, install the backend requirements so the psycopg driver is available.
# SUPABASE_URL=""
# SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# # AI / RAG (optional)
# # - This repo will not call external AI APIs unless you explicitly allow it.
# AI_FEATURE_ENABLED="false"
# AI_PROVIDER="disabled"
# AI_MODEL="unset"
# AI_API_KEY=""
# AI_ALLOW_EXTERNAL_CALLS="false"
# GROQ_API_KEY=""
# GROQ_MODEL="llama-3.1-8b-instant"

# # Scraper / ingestion (safe defaults)
# SCRAPER_USER_AGENT="usv-events-platform/0.1 (local-dev)"
# SCRAPER_MAX_PAGES="25"
