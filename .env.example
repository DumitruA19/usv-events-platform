# Monorepo env template
#
# Backend env lives in: `backend/.env`
# Frontend env lives in: `frontend/.env`

### Backend (FastAPI)
# APP_NAME="USV University Events Management Platform"
# ENV="local"
# DATABASE_URL="postgresql+psycopg://postgres.<project_ref>:<db_password>@aws-1-<region>.pooler.supabase.com:6543/postgres?sslmode=require"
# JWT_SECRET_KEY="change-me"
# JWT_ALGORITHM="HS256"
# JWT_ACCESS_TOKEN_EXPIRES_MINUTES="60"
# JWT_REFRESH_TOKEN_EXPIRES_DAYS="14"
# STORAGE_DIR="./storage"
# INTEGRATIONS_MODE="real"
# FRONTEND_BASE_URL="http://localhost:5173"
# OAUTH_STATE_SECRET_KEY="change-me"
# STUDENT_EMAIL_DOMAINS="student.usv.ro"
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI="http://localhost:8000/auth/google/callback"
# GOOGLE_CALENDAR_ID="primary"
# DEFAULT_TIMEZONE="Europe/Bucharest"
# SUPABASE_URL=""
# SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""
# AI_FEATURE_ENABLED="true"
# GROQ_API_KEY=""
# GROQ_MODEL="llama-3.1-8b-instant"
# SCRAPER_USER_AGENT="usv-events-platform/0.1 (local-dev)"
# SCRAPER_MAX_PAGES="25"

### Frontend (Vite)
# VITE_API_BASE_URL="http://127.0.0.1:8000"
# VITE_APP_URL="http://localhost:5173"

